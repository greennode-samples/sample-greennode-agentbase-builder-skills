# __PROJECT_NAME__ — runtime config for APP_ENV=__APP_ENV__ (COMMITTED: non-secret values only, reviewed in PRs).
#
# Format read by every deploy path (CI, /agentbase-deploy --env-file, docker run --env-file): ONE KEY=VALUE per
# line, NO quotes, NO inline comments, NO `export`, NO ${VAR}. Lint: make check-env ENV_FILE=<this file>
#
# Secrets: `<set-in-deploy>` = required, empty = optional. CI fills them from the GitHub Environment secrets
# (deploy/render_runtime_spec.py; set each with `gh secret set <NAME> --env __APP_ENV__`, which prompts without echo); for
# /agentbase-deploy run `make set-secret ENV_FILE=src/backend/.env.__APP_ENV__` in your own terminal: it creates the
# git-ignored copy of this file and asks for each secret with hidden input — never paste one into a chat. Secrets that
# must NOT be here at all: external-service keys used by tools (AgentBase Identity — /agentbase-build-identity).
# Never set GREENNODE_* (the Runtime injects them) or AGENT_VERSION (= image tag, baked in by docker-build / CI).
# Empty value = the default from app/config.py (env_ignore_empty). Full list of variables: .env.example
APP_ENV=__APP_ENV__
AGENT_NAME=__PROJECT_NAME__
LOG_LEVEL=INFO
# Time zone of the per-turn date/time given to the model (IANA name)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# LLM — LLM_API_KEY: one key per agent per environment (/agentbase-llm), with a Rate Limit
LLM_API_KEY=<set-in-deploy>
LLM_MODEL=
LLM_MODEL_REASONING=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=
LLM_TASK_TIERS={}
LLM_TIER_FALLBACKS={}
LLM_FALLBACK_MODELS=[]
LLM_ADAPTIVE_ROUTING=false
# Per-task output token caps (format in .env.example; empty = the app defaults)
LLM_TASK_MAX_TOKENS=

# Memory — a separate store per environment (/agentbase-memory)
MEMORY_BACKEND=agentbase
MEMORY_ID=
MEMORY_STRATEGY_ID=
LTM_ENABLED=false
# Recall threshold and max stored fact length (empty = the app defaults)
LTM_MIN_SCORE=
LTM_FACT_MAX_CHARS=
# ≈ 10 / max replicas (10 concurrent Memory requests per IAM account, shared by all replicas)
MEMORY_MAX_CONCURRENCY=6

# Inbound auth — jwt for end users; api_key only for trusted server callers (set AUTH_API_KEY_SHA256 then)
AUTH_MODE=jwt
AUTH_TOKEN_HEADER=Authorization
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALLOW_NO_AUDIENCE=false
AUTH_ALLOWED_CLIENT_IDS=[]
AUTH_API_KEY_SHA256=[]

# Tools — this environment's MCP Gateway, HITL patterns, Identity consent page
MCP_GATEWAY_URL=
HITL_TOOLS=[]
IDENTITY_CALLBACK_URL=
# Per-user credentials (user_access_token / user_api_key) need a verified user: keep false unless AUTH_MODE=api_key
# callers are trusted to assert the user (see /agentbase-build-identity)
IDENTITY_TRUST_ASSERTED_USER=false
MAX_TOOL_ROUNDS=8
REFLECTION_ENABLED=false
REFLECTION_TIMEOUT_S=

# A2A (off unless decision guide §5) — A2A_PUBLIC_URL = this environment's runtime endpoint
A2A_ENABLED=false
A2A_PUBLIC_URL=

# Feedback HMAC key (optional secret; empty = derived from the injected IAM secret)
FEEDBACK_SIGNING_KEY=

# Langfuse — keys are secrets (optional: empty = tracing off); data residency ⇒ a self-hosted URL
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_SAMPLE_RATE=1.0
TRACE_MASK_PII=true
