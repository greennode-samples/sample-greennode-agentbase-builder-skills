# Expo only exposes variables prefixed EXPO_PUBLIC_ — do NOT put secrets here (the bundle is public).
# AgentBase Runtime endpoint (from /agentbase-deploy), local: http://<LAN-IP>:8080
EXPO_PUBLIC_AGENT_URL=http://127.0.0.1:8080
# jwt | none (none only with backend AUTH_MODE=none locally)
EXPO_PUBLIC_AUTH_MODE=none
# Must match backend AUTH_TOKEN_HEADER
EXPO_PUBLIC_AUTH_TOKEN_HEADER=Authorization
# OIDC (Authorization Code + PKCE, public client — no client secret)
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_SCOPES=openid profile email offline_access
EXPO_PUBLIC_OIDC_AUDIENCE=
# Enable SSE streaming
EXPO_PUBLIC_STREAMING=true
