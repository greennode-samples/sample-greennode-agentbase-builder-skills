# Expo only exposes variables prefixed EXPO_PUBLIC_ — do NOT put secrets here (the bundle is public).
# This file is for LOCAL development only: .env is git-ignored, so EAS Build never sees it — release builds get these
# values from `eas env:create` / eas.json "env" (see SKILL.md). Release builds refuse http:// and an empty IdP config.
#
# Runtime endpoint (from /agentbase-deploy) or BFF base URL. Local backend: iOS simulator / web http://127.0.0.1:8080,
# Android emulator http://10.0.2.2:8080 (or `adb reverse tcp:8080 tcp:8080`), real device http://<LAN-IP>:8080
EXPO_PUBLIC_AGENT_URL=http://127.0.0.1:8080
# jwt | none (none only with backend AUTH_MODE=none locally)
EXPO_PUBLIC_AUTH_MODE=none
# Header the app sends the user JWT in (`Bearer <JWT>`): Authorization for Direct AND BFF mode.
# Direct mode: = backend AUTH_TOKEN_HEADER. BFF mode: keep Authorization (the BFF forwards it as the custom header).
EXPO_PUBLIC_AUTH_TOKEN_HEADER=Authorization
# OIDC (Authorization Code + PKCE, public client — no client secret). Per-IdP values: SKILL.md
EXPO_PUBLIC_OIDC_ISSUER=
EXPO_PUBLIC_OIDC_CLIENT_ID=
EXPO_PUBLIC_OIDC_SCOPES=openid profile email offline_access
EXPO_PUBLIC_OIDC_AUDIENCE=
# iOS: true = private browser session (no SSO cookie shared with Safari; credentials asked at every sign-in)
EXPO_PUBLIC_OIDC_EPHEMERAL_SESSION=false
# Enable SSE streaming
EXPO_PUBLIC_STREAMING=true
# Stop waiting when the agent sends nothing for this many seconds (backend REQUEST_TIMEOUT_S + margin)
EXPO_PUBLIC_IDLE_TIMEOUT_S=200
