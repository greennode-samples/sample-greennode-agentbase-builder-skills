# MCP server env (prefix MCP_). Local: `cp .env.example .env`. Deploy: pass via the runtime env file, do NOT bake into the image.
MCP_APP_ENV=local
MCP_SERVER_NAME=__SERVER_NAME__
MCP_PORT=8080
# Public URL of the MCP endpoint = <runtime endpoint>/mcp (resource identifier RFC 9728)
MCP_RESOURCE_URL=http://localhost:8080/mcp

# none (local only — no token, current_user() = MCP_DEV_USER) | api_key | jwt
MCP_AUTH_MODE=none
MCP_DEV_USER=dev-user

# api_key: JSON list of SHA-256 hex. The raw key is stored in AgentBase Identity (API key provider) for the Gateway to send
#   uv run python -c "import secrets,hashlib;k=secrets.token_urlsafe(32);print(k);print(hashlib.sha256(k.encode()).hexdigest())"
MCP_API_KEY_SHA256=[]

# jwt: IdP issuing tokens (OAuth 2LO/3LO or inbound forward)
MCP_ISSUER=
MCP_JWKS_URL=
MCP_AUDIENCE=
MCP_USER_CLAIM=sub
# Scopes required for EVERY request (JSON list); per-tool scopes use require_scope() in server.py
MCP_REQUIRED_SCOPES=[]

# Data & internal system used by the tools
MCP_DB_PATH=mcp.db
# Base URL of the internal system (get_product calls <MCP_BACKEND_URL>/products/<sku>); empty ⇒ tool says "not configured"
MCP_BACKEND_URL=
# Service credential for the internal system — set in the runtime env / secret store, never commit
MCP_BACKEND_TOKEN=
MCP_BACKEND_TIMEOUT_S=10
