# Copied to .env.local by setup_web.sh (git-ignored). Production: set these in the hosting platform's environment.
#
# ── Browser (NEXT_PUBLIC_*: inlined into the PUBLIC JavaScript bundle at build time — NEVER a secret or token) ──────
# Enable SSE streaming of the answer
NEXT_PUBLIC_STREAMING=true
# Stop waiting when the agent sends nothing for this many seconds (backend REQUEST_TIMEOUT_S + margin)
NEXT_PUBLIC_IDLE_TIMEOUT_S=200
#
# ── Server only: the BFF (Next.js route handlers). Never prefix these with NEXT_PUBLIC_ ─────────────────────────────
# AgentBase Runtime endpoint (from /agentbase-deploy) or the local backend. Production: https:// only
BFF_AGENT_URL=http://127.0.0.1:8080
# jwt: OIDC sign-in, the user's access token goes to the agent · none: local backend with AUTH_MODE=none (dev only)
BFF_AUTH_MODE=none
# How the Runtime endpoint authenticates (its Inbound Auth): jwt (JWT / No authorization: user token in Authorization,
# backend AUTH_TOKEN_HEADER=Authorization) · iam (IAM Permissions: IAM token in Authorization, user token in
# X-GreenNode-AgentBase-Custom-User-Token = backend AUTH_TOKEN_HEADER)
BFF_RUNTIME_AUTH=jwt
# iam only: a service account of the BFF allowed to invoke the runtime (secret — the user sets it, never in chat)
BFF_IAM_CLIENT_ID=
BFF_IAM_CLIENT_SECRET=
# OIDC client of this web app (Authorization Code + PKCE). Redirect URI to register: <BFF_APP_ORIGIN>/api/auth/callback,
# post-logout redirect URI: <BFF_APP_ORIGIN>/
BFF_OIDC_ISSUER=
BFF_OIDC_CLIENT_ID=
# Optional: confidential client (recommended for a BFF). Empty = public client (PKCE only)
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_SCOPES=openid profile email offline_access
# Auth0: the API identifier (else the access token is opaque). Others: empty
BFF_OIDC_AUDIENCE=
# Public origin of this app (redirect URI, CSRF Origin check). Production: https:// (Secure, __Host- cookies)
BFF_APP_ORIGIN=http://localhost:3000
# Encrypts the session cookie: >= 32 random characters (openssl rand -base64 48). Required in production; empty in
# development = a random secret per server start
BFF_SESSION_SECRET=
# Absolute session lifetime (seconds); the access token is refreshed inside it
BFF_SESSION_MAX_AGE_S=28800
